# Threat Defense Swarm - Environment Configuration

# OpenAI Configuration (Optional: system falls back to mock LLM if unset or keyless)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Microservice Endpoints
TRIAGE_PORT=8001
TRIAGE_URL=http://localhost:8001

RESOLUTION_PORT=8002
RESOLUTION_URL=http://localhost:8002

SABOTEUR_PORT=8003
SABOTEUR_URL=http://localhost:8003

# Chaos Configuration
CHAOS_ENABLED=true
CHAOS_SEED=12345
CHAOS_PROMPT_INJECTION_RATE=0.20
CHAOS_PACKET_DROP_RATE=0.15
CHAOS_TOOL_503_RATE=0.15

# Evaluation Harness Configuration
RUN_COUNT=100
LOG_LEVEL=INFO
